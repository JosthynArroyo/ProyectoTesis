@startuml
skinparam shadowing false
skinparam componentStyle rectangle

node "Cliente" as client {
  node "Navegador web" as browser {
    artifact "Blade renderizado" as blade
    artifact "Assets Vite\nCSS + JS + fetch()" as vite
  }
}

node "Servidor web / PHP" as webserver {
  artifact "public/index.php" as entrypoint
}

node "Aplicacion Laravel 12.20.0" as laravel {
  component "Routes web\n(routes/web.php)" as routes
  component "Middlewares\nAuth, role, feature,\naccount active,\nno pending payments" as middleware
  component "Controllers MVC" as controllers
  component "Services\nPagoService,\nPriorityEvaluator,\nWhatsAppService,\nVisionClient" as services
  component "Events / Jobs / Mail" as async
  folder "Storage local\nPDFs, comprobantes,\nrecetas, resultados" as storage
}

database "SQLite\nDB_CONNECTION=sqlite" as sqlite
cloud "SMTP\nMAIL_MAILER=smtp" as smtp
cloud "Twilio WhatsApp" as twilio
node "Servicio Vision CAPTCHA\nHTTP (VISION_URL)" as vision

browser --> webserver : HTTPS
webserver --> entrypoint
entrypoint --> routes
routes --> middleware
middleware --> controllers
controllers --> services
controllers --> sqlite
services --> sqlite
controllers --> storage
services --> storage
controllers --> async
services --> async
async --> smtp
async --> twilio
services --> vision

note right of routes
No existe `routes/api.php`.
Los endpoints JSON `/api/...`
estan definidos dentro de
`routes/web.php`.
end note

note bottom of webserver
Supuesto controlado:
el repo no incluye manifiestos
de hosting ni permite afirmar
si el servidor real es Apache,
Nginx, PHP-FPM o `artisan serve`.
end note

note bottom of vision
Supuesto controlado:
el repositorio versiona el cliente HTTP
y la URL configurable, pero no el
proceso del servicio de vision.
end note

@enduml
