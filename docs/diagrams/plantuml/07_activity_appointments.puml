@startuml
skinparam shadowing false

start

partition Paciente {
  :Autenticarse y abrir\n"Agendar cita";
  :Seleccionar especialidad,\nprofesional, fecha y hora;
}

partition Sistema {
  :Consultar tarifa y slots\npor rutas /api en web.php;
  if (Tiene pagos pendientes?) then (Si)
    :Redirigir a modulo de pagos;
    stop
  else (No)
  endif

  :Validar fecha con al menos\n1 hora de anticipacion;
  :Validar horario configurado;
  :Validar bloque alineado\ny sin choques;

  if (Especialidad =\nLaboratorio Clinico?) then (Si)
    :Preparar datos de\nLaboratorioOrden;
  else (No)
  endif

  :Crear cita pendiente;
  :Calcular prioridad con\nPriorityEvaluator;

  if (Especialidad =\nLaboratorio Clinico?) then (Si)
    :Crear LaboratorioOrden;
  else (No)
  endif

  :Disparar CitaAgendada;
  :Crear factura borrador,\npago pendiente y notificaciones;
}

partition Doctor {
  :Revisar citas pendientes;
  if (Acepta la cita?) then (No)
    :Marcar cita cancelada;
    stop
  else (Si)
    :Confirmar cita;
  endif
}

partition Sistema {
  if (La cita vence sin atencion?) then (Si)
    :CitaNoShowService marca\nno_se_presento;
    stop
  else (No)
  endif
}

partition Doctor {
  :Atender al paciente;
  :Registrar y firmar\nHistoria Clinica SOAP;

  if (SOAP firmada?) then (No)
    :Volver al formulario SOAP;
  else (Si)
    :Marcar cita como realizada;
  endif

  if (Genera receta?) then (Si)
    :Crear PDF y enviar\nreceta al paciente;
  else (No)
  endif

  if (Solicita laboratorio\ndesde consulta?) then (Si)
    :Crear orden de laboratorio\nligada a la cita;
  else (No)
  endif
}

partition Laboratorio {
  if (Existe resultado a publicar?) then (Si)
    :Marcar muestra tomada;
    :Subir PDF de resultado;
    :Notificar por correo\nal paciente;
  else (No)
  endif
}

stop
@enduml
