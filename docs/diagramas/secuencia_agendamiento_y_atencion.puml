@startuml
skinparam shadowing false
autonumber

actor Paciente
actor Doctor
actor Administrador

boundary "UI Web" as UI
control "CitaController" as CitaCtrl
control "Paciente\\PagoController" as PacPagoCtrl
control "Admin\\PagoController" as AdminPagoCtrl
control "Doctor\\SoapController" as SoapCtrl
control "PriorityEvaluator" as PriorityEvaluator
control "PagoService" as PagoService
control "Event Bus" as EventBus
control "CrearFacturaBorrador" as CrearFactura
control "CrearPagoPendiente" as CrearPago
control "GenerarOrdenCobroAlAtenderCita" as GenerarOrden
queue "Queue / Jobs" as Queue
control "EnviarConfirmacionCitaJob" as JobConfirmacion
control "Mailer" as Mailer
database "SQLite / MySQL" as DB

== Agendamiento ==
Paciente -> UI : Completa formulario de cita
UI -> CitaCtrl : POST /paciente/crear-cita
CitaCtrl -> PagoService : pacienteTieneBloqueo(paciente_id)
PagoService --> CitaCtrl : false
CitaCtrl -> DB : Validar horario, slot y choques
CitaCtrl -> DB : INSERT cita estado=pendiente
CitaCtrl -> PriorityEvaluator : apply(cita)
PriorityEvaluator --> CitaCtrl : prioridad calculada
CitaCtrl -> DB : UPDATE cita con prioridad

opt La cita pertenece a laboratorio
  CitaCtrl -> DB : INSERT laboratorio_ordenes
end

CitaCtrl -> EventBus : dispatch CitaAgendada(cita)
EventBus -> CrearFactura : handle(evento)
CrearFactura -> DB : INSERT facturas
CrearFactura -> DB : INSERT factura_items

EventBus -> CrearPago : handle(evento)
CrearPago -> PagoService : crearParaCita(cita, actor)
PagoService -> DB : INSERT pagos
PagoService -> DB : INSERT payment_status_logs

CitaCtrl -> Queue : dispatch EnviarConfirmacionCitaJob
Queue -> JobConfirmacion : handle()
JobConfirmacion -> Mailer : Enviar correo a paciente y doctor
CitaCtrl --> UI : Redirect con mensaje de exito

== Confirmacion y atencion ==
Doctor -> UI : Revisa bandeja de citas
UI -> CitaCtrl : POST /doctor/citas/{id}/aceptar
CitaCtrl -> DB : UPDATE cita estado=confirmada
CitaCtrl --> UI : Cita confirmada

Doctor -> UI : Registra y firma nota SOAP
UI -> SoapCtrl : POST /doctor/citas/{id}/soap/firmar
SoapCtrl -> DB : UPSERT notas_soap estado=signed
SoapCtrl -> DB : REPLACE diagnosticos SOAP
SoapCtrl -> DB : INSERT cita_eventos tipo=soap_firmada
SoapCtrl --> UI : Nota firmada

Doctor -> UI : Marca la cita como realizada
UI -> CitaCtrl : POST /doctor/citas/{id}/realizar
CitaCtrl -> DB : SELECT notas_soap
DB --> CitaCtrl : nota firmada
CitaCtrl -> DB : UPDATE cita estado=realizada
CitaCtrl -> EventBus : dispatch CitaAtendida(cita)
EventBus -> GenerarOrden : handle(evento)
GenerarOrden -> PagoService : crearOrdenParaCitaRealizada(cita, actor)
PagoService -> DB : UPDATE pagos con folio y token
PagoService -> DB : Guardar orden PDF en storage
CitaCtrl --> UI : Cita realizada

== Pago ==
Paciente -> UI : Envia metodo de pago y comprobante
UI -> PacPagoCtrl : POST /paciente/pagos/{id}/enviar
PacPagoCtrl -> PagoService : cambiarEstado(pago, en_verificacion|pendiente)
PagoService -> DB : UPDATE pagos
PagoService -> DB : INSERT payment_status_logs
PacPagoCtrl --> UI : Pago registrado

Administrador -> UI : Revisa pago
UI -> AdminPagoCtrl : POST /admin/pagos/{id}/aprobar
AdminPagoCtrl -> PagoService : cambiarEstado(pago, pagado)
PagoService -> DB : UPDATE pagos aprobado_por/aprobado_en
PagoService -> DB : INSERT payment_status_logs
PagoService -> DB : INSERT payment_receipts
PagoService -> DB : INSERT payment_receipt_logs
PagoService -> DB : Guardar recibo PDF en storage
AdminPagoCtrl --> UI : Pago aprobado y recibo emitido
@enduml
