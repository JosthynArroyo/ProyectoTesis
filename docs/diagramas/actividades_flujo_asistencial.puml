@startuml
skinparam shadowing false
title Flujo asistencial y administrativo

start

partition Paciente {
  :Inicia sesion o usa chatbot;
  if (Usa chatbot?) then (si)
    :Solicita reto CAPTCHA;
    if (CAPTCHA valido?) then (si)
      :Verifica identidad;
    else (no)
      :Fin del intento;
      stop
    endif
  endif

  :Selecciona especialidad,\nprofesional, fecha y hora;
}

partition Sistema {
  :Valida horario, disponibilidad,\nprioridad y bloqueo por pagos;
  if (Solicitud valida?) then (si)
    :Crea cita pendiente;
    :Calcula prioridad clinica;
    :Genera factura borrador;
    :Genera pago pendiente;
    :Envia notificaciones iniciales;
  else (no)
    :Muestra errores de validacion;
    stop
  endif
}

partition Doctor {
  :Revisa la bandeja de citas;
  if (Acepta la cita?) then (si)
    :Confirma cita;
  else (no)
    :Rechaza o cancela cita;
    stop
  endif

  :Atiende al paciente;
  :Registra SOAP;
  if (SOAP firmada?) then (si)
    :Marca cita como realizada;
  else (no)
    :No puede cerrar la consulta;
    stop
  endif

  if (Requiere receta?) then (si)
    :Emite receta PDF;
  endif

  if (Requiere orden de laboratorio?) then (si)
    :Genera orden de laboratorio;
  endif
}

partition Laboratorio {
  if (Hay orden de laboratorio?) then (si)
    :Registra toma de muestra;
    :Procesa muestra;
    :Publica resultado;
  endif
}

partition Sistema {
  :Genera orden de cobro\ncuando la cita queda realizada;
}

partition Paciente {
  :Selecciona metodo de pago;
  if (Transferencia?) then (si)
    :Adjunta comprobante;
  else (no)
    :Confirma pago en clinica;
  endif
}

partition Administracion {
  :Revisa el pago;
  if (Pago valido?) then (si)
    :Aprueba pago;
    :Emite recibo;
  else (no)
    :Rechaza o anula pago;
  endif
}

partition Sistema {
  :Actualiza historial clinico,\ntrazabilidad y documentos;
  stop
}
@enduml
