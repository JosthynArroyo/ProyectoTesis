@startuml
skinparam shadowing false
skinparam componentStyle rectangle

node "Cliente" as client {
  node "Navegador web" as browser {
    artifact "Blade HTML"
    artifact "JS modules\nagenda, chatbot,\npagos, laboratorio"
    artifact "face-api.js\ncaptura facial"
  }
}

node "Servidor web" as server {
  node "Nginx / Apache" as web

  node "PHP-FPM" as php {
    component "Laravel App" as laravel
    component "Rutas + Middleware" as routes
    component "Controllers" as controllers
    component "Services + Listeners" as services
    component "Jobs + Scheduler" as jobs
  }
}

database "SQLite / MySQL" as db

folder "Storage local/public" as storage {
  artifact "PDFs\nrecetas, recibos,\nordenes de cobro"
  artifact "Uploads\ncomprobantes,\nresultados"
  artifact "Assets publicos\nimagenes, captcha"
}

cloud "Worker" as worker {
  component "queue:work" as queueWorker
  component "Cron / schedule:run" as cron
}

cloud "Servicios externos" as external {
  component "SMTP / Mail" as smtp
  component "Twilio WhatsApp" as twilio
  component "Vision API" as vision
}

browser --> web : HTTPS
web --> php : FastCGI / PHP

routes --> controllers
controllers --> services
controllers --> db
services --> db
laravel --> storage : archivos y PDFs
services --> smtp : correos
services --> twilio : mensajes WhatsApp
services --> vision : clasificacion CAPTCHA

queueWorker --> laravel : procesa jobs
cron --> laravel : ejecuta comandos\nrecordatorios y no-show

browser --> storage : descarga PDFs e imagenes
laravel --> db : Eloquent / SQL
@enduml
