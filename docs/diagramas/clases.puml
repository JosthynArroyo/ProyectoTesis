@startuml
skinparam classAttributeIconSize 0
skinparam shadowing false
hide empty members

package "Seguridad y usuarios" {
  class User <<Entity>> {
    +id: bigint
    +name: string
    +email: string
    +dni: string
    +telefono: string
    +status: string
    +precio_consulta: decimal
    +moneda: string
    +theme_preference: string
    +hasRole(role): bool
    +hasPendingPaymentBlocks(): bool
  }

  class Role <<Entity>> {
    +id: bigint
    +name: string
  }

  class FaceProfile <<Entity>> {
    +id: bigint
    +user_id: bigint
    +threshold: float
    +failed_attempts: int
    +last_verified_at: datetime
  }

  class PatientFlag <<Entity>> {
    +id: bigint
    +user_id: bigint
    +adulto_mayor: bool
    +embarazo: bool
    +discapacidad: bool
    +cronico: bool
  }

  class FeatureAccessRequest <<Entity>> {
    +id: bigint
    +user_id: bigint
    +feature: string
    +status: string
    +approved_until: datetime
    +isActive(): bool
  }

  class SiteSetting <<Entity>> {
    +id: bigint
    +key: string
    +section: string
    +type: string
    +value: text
  }
}

package "Agenda" {
  class Especialidad <<Entity>> {
    +id: bigint
    +nombre: string
    +descripcion: text
    +activo: bool
    +orden: int
  }

  class Horario <<Entity>> {
    +id: bigint
    +doctor_id: bigint
    +fecha: date
    +hora_inicio: time
    +hora_fin: time
    +intervalo_minutos: int
    +estaDisponible(): bool
    +hasSolapamiento(): bool
  }

  class Cita <<Entity>> {
    +id: bigint
    +paciente_id: bigint
    +doctor_id: bigint
    +especialidad_id: bigint
    +fecha: date
    +hora: time
    +motivo_consulta: string
    +estado: string
    +activo: bool
    +prioridad_nivel: string
    +refreshPriority(): bool
    +estaVencida(): bool
  }

  class CitaEvento <<Entity>> {
    +id: bigint
    +cita_id: bigint
    +user_id: bigint
    +tipo: string
    +de_estado: string
    +a_estado: string
    +comentario: string
  }
}

package "Clinico" {
  class NotaSoap <<Entity>> {
    +id: bigint
    +cita_id: bigint
    +estado: string
    +signed_at: datetime
    +signed_by: bigint
    +isSigned(): bool
  }

  class NotaSoapDiagnostico <<Entity>> {
    +id: bigint
    +nota_soap_id: bigint
    +tipo: string
    +texto: string
    +cie10: string
  }

  class NotaSoapEnmienda <<Entity>> {
    +id: bigint
    +nota_soap_id: bigint
    +user_id: bigint
    +motivo: text
    +contenido: text
  }

  class Receta <<Entity>> {
    +id: bigint
    +cita_id: bigint
    +diagnostico: text
    +medicamentos: text
    +indicaciones: text
    +pdf_path: string
    +enviado_en: datetime
  }
}

package "Facturacion y pagos" {
  class Factura <<Entity>> {
    +id: bigint
    +cita_id: bigint
    +paciente_id: bigint
    +doctor_id: bigint
    +subtotal: decimal
    +impuestos: decimal
    +total: decimal
    +estado: string
    +recalcularTotales(): void
  }

  class FacturaItem <<Entity>> {
    +id: bigint
    +factura_id: bigint
    +descripcion: string
    +cantidad: int
    +precio_unitario: decimal
    +total_linea: decimal
  }

  class Pago <<Entity>> {
    +id: bigint
    +cita_id: bigint
    +paciente_id: bigint
    +monto: decimal
    +metodo_pago: string
    +estado: string
    +folio_unico: string
    +token_publico: string
    +esEditablePorPaciente(): bool
    +tieneOrdenCobro(): bool
  }

  class PaymentStatusLog <<Entity>> {
    +id: bigint
    +pago_id: bigint
    +estado_anterior: string
    +estado_nuevo: string
    +actor_id: bigint
    +motivo: text
  }

  class PaymentReceipt <<Entity>> {
    +id: bigint
    +pago_id: bigint
    +folio_recibo: string
    +emitido_en: datetime
    +emitido_por: bigint
    +pdf_path: string
    +pdfEsValido(): bool
  }

  class PaymentReceiptLog <<Entity>> {
    +id: bigint
    +payment_receipt_id: bigint
    +estado_nuevo: string
    +actor_id: bigint
    +motivo: text
  }

  class BookingOverrideLog <<Entity>> {
    +id: bigint
    +paciente_id: bigint
    +actor_id: bigint
    +cita_id: bigint
    +motivo: text
  }
}

package "Laboratorio" {
  class LabTest <<Entity>> {
    +id: bigint
    +nombre: string
    +tipo: string
    +categoria: string
    +requiere_orden: bool
    +es_rutina: bool
  }

  class MedicalOrder <<Entity>> {
    +id: bigint
    +patient_id: bigint
    +doctor_id: bigint
    +lab_test_id: bigint
    +status: string
  }

  class LabOrder <<Entity>> {
    +id: bigint
    +patient_id: bigint
    +doctor_id: bigint
    +medical_order_id: bigint
    +source: string
    +priority: string
    +status: string
    +scheduled_at: datetime
  }

  class LabOrderItem <<Entity>> {
    +id: bigint
    +lab_order_id: bigint
    +lab_test_id: bigint
    +preparacion_snapshot: text
    +indicaciones_snapshot: text
    +resultado_url: string
  }

  class LaboratorioOrden <<Entity>> {
    +id: bigint
    +cita_id: bigint
    +solicitante_id: bigint
    +tipo_examen: string
    +prioridad: string
    +estado: string
    +resultado_path: string
  }
}

package "Soporte y canales" {
  class Contacto <<Entity>> {
    +id: bigint
    +nombre: string
    +email: string
    +telefono: string
    +asunto: string
  }

  class WhatsappMessage <<Entity>> {
    +id: bigint
    +cita_id: bigint
    +user_id: bigint
    +evento: string
    +rol_receptor: string
    +estado: string
    +provider: string
  }

  class CaptchaImage <<Entity>> {
    +id: bigint
    +class_key: string
    +dataset_split: string
    +image_path: string
  }

  class CaptchaChallenge <<Entity>> {
    +id: bigint
    +target_key: string
    +attempts: int
    +max_attempts: int
    +expires_at: datetime
    +verified_at: datetime
  }
}

package "Servicios de aplicacion" {
  class PriorityEvaluator <<Service>> {
    +apply(cita): void
    +sanitizeMotivo(raw): string
  }

  class PagoService <<Service>> {
    +crearParaCita(cita, actor): Pago
    +crearOrdenParaCitaRealizada(cita, actor): Pago
    +cambiarEstado(pago, estado, actor): Pago
    +emitirReciboParaPago(pago, actor): PaymentReceipt
  }

  class WhatsAppService <<Service>> {
    +sendCitaAceptada(cita, recipient, rol): WhatsappMessage
    +sendRecordatorio6h(cita, recipient, rol, inicio): WhatsappMessage
  }

  class FaceRecognitionService <<Service>> {
    +compare(incoming, profile): float
    +isMatch(distance, profile): bool
  }

  class VisionClient <<Service>> {
    +classify(imagePath): array
  }
}

User "*" -- "*" Role : role_user
User "*" -- "*" Especialidad : doctor_especialidad
User "1" -- "0..1" FaceProfile
User "1" -- "0..1" PatientFlag
User "1" -- "0..*" FeatureAccessRequest

User "1" <-- "0..*" Horario : doctor
User "1" <-- "0..*" Cita : paciente
User "1" <-- "0..*" Cita : doctor
Especialidad "1" <-- "0..*" Cita
Cita "1" -- "0..*" CitaEvento

Cita "1" -- "0..1" NotaSoap
NotaSoap "1" -- "0..*" NotaSoapDiagnostico
NotaSoap "1" -- "0..*" NotaSoapEnmienda
Cita "1" -- "0..1" Receta

Cita "1" -- "0..1" Factura
Factura "1" -- "1..*" FacturaItem
Cita "1" -- "0..1" Pago
Pago "1" -- "0..*" PaymentStatusLog
Pago "1" -- "0..1" PaymentReceipt
PaymentReceipt "1" -- "0..*" PaymentReceiptLog
Cita "0..1" <-- "0..*" BookingOverrideLog

Cita "1" -- "0..1" LaboratorioOrden
User "1" <-- "0..*" LaboratorioOrden : solicitante
User "1" <-- "0..*" MedicalOrder : patient
User "1" <-- "0..*" MedicalOrder : doctor
LabTest "1" <-- "0..*" MedicalOrder
User "1" <-- "0..*" LabOrder : patient
User "1" <-- "0..*" LabOrder : doctor
MedicalOrder "0..1" <-- "0..*" LabOrder
LabOrder "1" -- "1..*" LabOrderItem
LabTest "1" <-- "0..*" LabOrderItem

Cita "1" -- "0..*" WhatsappMessage
User "1" -- "0..*" WhatsappMessage
CaptchaChallenge ..> CaptchaImage : option_image_ids

PriorityEvaluator ..> Cita
PagoService ..> Pago
PagoService ..> PaymentStatusLog
PagoService ..> PaymentReceipt
PagoService ..> BookingOverrideLog
WhatsAppService ..> WhatsappMessage
WhatsAppService ..> Cita
FaceRecognitionService ..> FaceProfile
VisionClient ..> CaptchaImage
@enduml
