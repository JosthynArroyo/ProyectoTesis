APP_NAME=ClinicaDB
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
APP_TIMEZONE=America/Guayaquil

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# IPs/CIDRs de proxies reversos autorizados (Cloudflare, balanceador y proxy interno).
# Sin valor, Laravel ignora todos los headers reenviados. No usar *.
TRUSTED_PROXIES=

PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=proyecto_clinica_ja
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=file
CACHE_PREFIX=laravel_cache

QUEUE_CONNECTION=database
MEDIA_QUEUE_CONNECTION=database
MEDIA_QUEUE=media
FILESYSTEM_DISK=r2_private
IMAGE_STORAGE_DISK=r2_public
AVATAR_STORAGE_DISK=r2_private
PRIVATE_DOCUMENT_STORAGE_DISK=r2_private

# Cloudflare R2
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_REGION=auto
R2_PUBLIC_BUCKET=
R2_PRIVATE_BUCKET=
R2_PUBLIC_URL=https://pub-EXAMPLE.r2.dev

R2_BACKUP_ACCESS_KEY_ID=
R2_BACKUP_SECRET_ACCESS_KEY=
R2_BACKUP_BUCKET=
R2_BACKUP_ENDPOINT=
R2_BACKUP_REGION=auto
BACKUP_ARCHIVE_PASSWORD=
BACKUP_MYSQLDUMP_PATH=mysqldump
BACKUP_MYSQL_PATH=mysql
BACKUP_RETENTION_DAILY=30
BACKUP_RETENTION_WEEKLY=12
BACKUP_RETENTION_MONTHLY=12
BACKUP_QUEUE_CONNECTION=database_backups
BACKUP_QUEUE=backups
BACKUP_QUEUE_RETRY_AFTER=2400

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="Nombre de la clinica"
CONTACTO_TO=soporte@clinica.test

WHATSAPP_DEFAULT_COUNTRY=EC

VITE_APP_NAME="${APP_NAME}"

ACCOUNT_INACTIVITY_DAYS=90
FACE_MATCH_THRESHOLD=0.55
FACE_MAX_FAILURES=5
IMAGE_WEBP_QUALITY=80
IMAGE_AVIF_QUALITY=60
IMAGE_GENERATE_AVIF=true
